# Leave QUOTE_BACKEND empty until a form service is connected.
# The site will not pretend a quote was sent while this is unset.
#
# Supported values: formspree, resend, webhook
QUOTE_BACKEND=

# Formspree form id (the part after /f/) or the full https://formspree.io/f/... URL
FORMSPREE_FORM_ID=

# Resend (https://resend.com). QUOTE_FROM_EMAIL must be a verified sender.
RESEND_API_KEY=
QUOTE_FROM_EMAIL=
QUOTE_TO_EMAIL=

# Generic JSON webhook. Works with a Supabase edge function, Zapier, Make, or similar.
# QUOTE_WEBHOOK_SECRET is optional. When set, it is sent as a Bearer token.
QUOTE_WEBHOOK_URL=
QUOTE_WEBHOOK_SECRET=

# Public site URL for SEO, with no trailing slash. Example: https://example.com
NEXT_PUBLIC_SITE_URL=
